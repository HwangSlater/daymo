{
  "expo": {
    "name": "Daymo",
    "slug": "daymo",
    "scheme": "daymo",
    "version": "1.0.0",
    "icon": "./assets/daymo-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hwangslater.daymo",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hwangslater.daymo",
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/daymo-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/daymo-icon-adaptive.png",
        "backgroundColor": "#3F4C8F"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/daymo-favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/daymo-splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0",
          "dark": {
            "image": "./assets/daymo-splash-dark.png",
            "backgroundColor": "#0D111A"
          },
          "android": {
            "image": "./assets/daymo-splash-android.png",
            "imageWidth": 288,
            "dark": {
              "image": "./assets/daymo-splash-android-dark.png"
            }
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 사진을 기록에 추가하려면 사진 접근 권한이 필요합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "96830b05-6f77-4039-9d15-71188e698545"
      }
    },
    "owner": "hwangslater"
  }
}
