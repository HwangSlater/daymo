{
  "expo": {
    "name": "Daymo",
    "slug": "daymo",
    "scheme": "daymo",
    "version": "0.1.0",
    "icon": "./assets/daymo-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hwangslater.daymo",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.hwangslater.daymo",
      "icon": "./assets/daymo-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/daymo-icon-adaptive.png",
        "backgroundColor": "#2E3457"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
