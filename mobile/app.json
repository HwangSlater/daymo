{
  "expo": {
    "name": "Daymo",
    "slug": "daymo",
    "scheme": "daymo",
    "version": "0.1.0",
    "icon": "./assets/daymo-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hwangslater.daymo",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.hwangslater.daymo",
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/daymo-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/daymo-icon-adaptive.png",
        "backgroundColor": "#3F4C8F"
      }
    },
    "web": {
      "favicon": "./assets/daymo-favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/daymo-splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0",
          "dark": {
            "image": "./assets/daymo-splash-dark.png",
            "backgroundColor": "#0D111A"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 사진을 기록에 추가하려면 사진 접근 권한이 필요합니다."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ]
  }
}
