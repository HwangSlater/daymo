{
  "expo": {
    "name": "Daymo",
    "slug": "daymo",
    "scheme": "daymo",
    "version": "0.1.0",
    "icon": "./assets/daymo-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/daymo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F0",
      "dark": {
        "image": "./assets/daymo-splash-dark.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D111A"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hwangslater.daymo",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.hwangslater.daymo",
      "icon": "./assets/daymo-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/daymo-icon-adaptive.png",
        "backgroundColor": "#2E3457"
      }
    },
    "web": {
      "favicon": "./assets/daymo-favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/daymo-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0",
          "dark": {
            "image": "./assets/daymo-splash-dark.png",
            "backgroundColor": "#0D111A"
          }
        }
      ]
    ]
  }
}
