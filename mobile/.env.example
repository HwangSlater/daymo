# Daymo 앱 환경변수 예시.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. 실제 .env 는 커밋하지 않는다.
#
# Expo 는 EXPO_PUBLIC_ 로 시작하는 값만 앱 번들에 넣어준다. 번들은 누구나
# 열어볼 수 있으므로 비밀번호, OAuth secret, 서명 키 같은 비밀값을 넣지 않는다.
# 그런 값은 서버 환경변수로 두며 docs/development/01-development-environment.md 를 따른다.
#
# 값을 바꾼 뒤에는 개발 서버를 다시 시작해야 반영된다.

# Daymo REST API. 비우면 운영 API인 https://api.daymo.xyz를 사용한다.
EXPO_PUBLIC_DAYMO_API_URL=https://api.daymo.xyz

# 소셜 로그인도 위 API 가 맡는다. 앱에 넣을 키는 없다. 서버에 키가 들어간
# 제공자만 버튼이 보인다(backend/.env.example).
# 웹은 같은 출처의 /oauth로 복귀한다. 서버 OAUTH_APP_REDIRECT_URIS에 정확한 주소를 등록한다.

# 네이버 지도·카카오맵 공유 링크의 장소명·주소를 조회하는 Daymo 서버 endpoint.
# Vercel 배포 시에는 https://<도메인>/api/naver-place 로 설정한다.
EXPO_PUBLIC_DAYMO_PLACE_RESOLVER_URL=

# 아래 값들은 앱 번들에 넣지 않고 서버 배포 환경변수로만 설정한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 개발자 REST API 키. 없어도 카카오맵 짧은 링크의 이름과 주소는 채운다.
# 넣어 두면 도로명 주소와 장소 종류까지 받는다.
KAKAO_REST_API_KEY=

# 브라우저에서 장소 조회를 부를 수 있는 출처. 쉼표로 여러 개를 적는다.
# 비워 두면 브라우저에서는 아무 데서도 못 부른다. 휴대폰 앱은 Origin 을 보내지
# 않으므로 이 값과 상관없이 그대로 된다.
# 예: https://daymo.app,https://www.daymo.app
ALLOWED_ORIGINS=
