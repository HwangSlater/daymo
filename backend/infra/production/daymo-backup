#!/usr/bin/env bash
set -euo pipefail

readonly LOCK_FILE=/run/daymo-backup.lock
readonly COMPOSE_FILE=/srv/daymo/current/backend/infra/production/compose.yml
readonly RUNTIME_ENV=/etc/daymo/secrets/runtime.env
readonly BACKUP_ENV=/etc/daymo/secrets/backup.env
readonly STAGING_DIR=/srv/daymo/backup-staging
readonly UPLOAD_DIR=/srv/daymo/uploads

exec 9>"$LOCK_FILE"
flock --nonblock 9 || exit 0

if [[ ! -r "$BACKUP_ENV" ]]; then
  echo "missing $BACKUP_ENV" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$BACKUP_ENV"
set +a

: "${RESTIC_REPOSITORY:?RESTIC_REPOSITORY is required}"
: "${RESTIC_PASSWORD_FILE:?RESTIC_PASSWORD_FILE is required}"
: "${RCLONE_CONFIG:?RCLONE_CONFIG is required}"

compose() {
  docker compose --env-file "$RUNTIME_ENV" -f "$COMPOSE_FILE" "$@"
}

mkdir -p "$STAGING_DIR"
dump_file="$STAGING_DIR/daymo-$(date -u +%Y%m%dT%H%M%SZ).dump"
cleanup() {
  rm -f "$dump_file"
}
trap cleanup EXIT

compose exec -T postgres sh -c \
  'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump --format=custom --username="$POSTGRES_USER" "$POSTGRES_DB"' \
  >"$dump_file"
test -s "$dump_file"

restic backup "$dump_file" "$UPLOAD_DIR" --tag daymo-daily
restic forget --keep-daily 14 --keep-weekly 8 --keep-monthly 6 --prune
restic snapshots --latest 1
