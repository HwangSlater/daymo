[Unit]
Description=Restore the latest Daymo off-site snapshot into a scratch database
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=daymo-alert@%n.service

[Service]
Type=oneshot
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/usr/local/sbin/daymo-verify-offsite
