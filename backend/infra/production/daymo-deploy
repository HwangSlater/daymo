#!/usr/bin/env bash
set -euo pipefail

readonly APP_ROOT=/srv/daymo
readonly APP_DIR="$APP_ROOT/current"
readonly RELEASES_DIR="$APP_ROOT/releases"
readonly RELEASE_ARCHIVE=/home/daymo-deploy/release.tar.gz
readonly ENV_FILE=/etc/daymo/secrets/runtime.env
readonly BACKUP_DIR="$APP_ROOT/backup-staging"
readonly IMAGE=daymo-api:local
readonly ROLLBACK_IMAGE=daymo-api:rollback
previous_dir=""

compose() {
  docker compose --env-file "$ENV_FILE" -f "$APP_DIR/backend/infra/production/compose.yml" "$@"
}

rollback() {
  echo "deployment health check failed; restoring the previous API image" >&2
  if [[ -n "$previous_dir" && -d "$previous_dir" ]]; then
    ln -sfn "$previous_dir" "$APP_DIR"
  fi
  if docker image inspect "$ROLLBACK_IMAGE" >/dev/null 2>&1; then
    docker tag "$ROLLBACK_IMAGE" "$IMAGE"
    compose up -d --no-build --force-recreate api nginx || true
  fi
  compose ps || true
  compose logs --tail=100 api nginx || true
}

if [[ ! -r "$ENV_FILE" ]]; then
  echo "missing $ENV_FILE" >&2
  exit 1
fi

if [[ ! -f "$RELEASE_ARCHIVE" || -L "$RELEASE_ARCHIVE" ]]; then
  echo "missing release archive" >&2
  exit 1
fi

if find "$RELEASE_ARCHIVE" -maxdepth 0 ! -user daymo-deploy -print -quit | grep -q .; then
  echo "release archive has an unexpected owner" >&2
  exit 1
fi

if tar -tzf "$RELEASE_ARCHIVE" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
  echo "release archive contains an unsafe path" >&2
  exit 1
fi

release_id="$(date -u +%Y%m%dT%H%M%SZ)"
release_dir="$RELEASES_DIR/$release_id"
mkdir -p "$release_dir" "$BACKUP_DIR"
tar --extract --gzip --file "$RELEASE_ARCHIVE" \
  --directory "$release_dir" --no-same-owner --no-same-permissions
find "$release_dir" -type f \( -name '._*' -o -name '.DS_Store' \) -delete

for required in \
  backend/Dockerfile \
  backend/pyproject.toml \
  backend/uv.lock \
  backend/alembic.ini \
  backend/infra/production/compose.yml \
  backend/infra/production/nginx.conf; do
  if [[ ! -f "$release_dir/$required" ]]; then
    echo "release is missing $required" >&2
    rm -rf "$release_dir"
    exit 1
  fi
done

docker compose --env-file "$ENV_FILE" \
  -f "$release_dir/backend/infra/production/compose.yml" config --quiet

if [[ -d "$APP_DIR" && ! -L "$APP_DIR" ]]; then
  previous_dir="$RELEASES_DIR/bootstrap-$release_id"
  mv "$APP_DIR" "$previous_dir"
elif [[ -L "$APP_DIR" ]]; then
  previous_dir="$(readlink -f "$APP_DIR")"
fi
ln -sfn "$release_dir" "$APP_DIR"

compose config --quiet
compose up -d postgres

backup_file="$BACKUP_DIR/pre-deploy-$release_id.sql.gz"
compose exec -T postgres sh -c \
  'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump --format=custom --username="$POSTGRES_USER" "$POSTGRES_DB"' \
  | gzip -1 >"$backup_file"
test -s "$backup_file"

if docker image inspect "$IMAGE" >/dev/null 2>&1; then
  docker tag "$IMAGE" "$ROLLBACK_IMAGE"
fi

compose build api
compose run --rm api alembic upgrade head
compose up -d --remove-orphans

# nginx 는 설정 파일을 컨테이너를 만들 때 붙인다. current 가 새 release 를
# 가리켜도 compose 가 보기에 경로 글자가 같아 다시 만들지 않고, 떠 있는 nginx 는
# 처음 붙인 옛 release 의 파일을 계속 본다. 내용이 달라졌을 때만 다시 만든다.
# 새 설정이 틀렸으면 아래 health 확인에서 걸려 되돌린다.
if ! compose exec -T nginx cat /etc/nginx/conf.d/default.conf | cmp -s - "$APP_DIR/backend/infra/production/nginx.conf"; then
  compose up -d --no-deps --force-recreate nginx || true
fi

for attempt in {1..30}; do
  if curl --fail --silent --show-error https://api.daymo.xyz/v1/health >/dev/null; then
    rm -f "$RELEASE_ARCHIVE"
    find "$BACKUP_DIR" -maxdepth 1 -type f -name 'pre-deploy-*.sql.gz' -mtime +7 -delete
    find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf {} +
    docker image prune --force --filter 'until=168h' >/dev/null
    exit 0
  fi
  sleep 2
done

rollback
exit 1
