#!/usr/bin/env bash
set -euo pipefail

readonly LOCK_FILE=/run/daymo-release-poller.lock
readonly STATE_FILE=/srv/daymo/deployed-sha
readonly API_URL='https://api.github.com/repos/HwangSlater/daymo/actions/workflows/ci.yml/runs?branch=main&status=success&per_page=1'
readonly COMPARE_URL='https://api.github.com/repos/HwangSlater/daymo/compare'
readonly RELEASE_ARCHIVE=/home/daymo-deploy/release.tar.gz
readonly APP_DIR=/srv/daymo/current

exec 9>"$LOCK_FILE"
flock --nonblock 9 || exit 0

latest_sha="$(
  curl --fail --silent --show-error --location \
    --header 'Accept: application/vnd.github+json' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    "$API_URL" \
    | jq --exit-status --raw-output '.workflow_runs[0].head_sha'
)"

if [[ ! "$latest_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "GitHub returned an invalid commit SHA" >&2
  exit 1
fi

if [[ -r "$STATE_FILE" ]] && grep --fixed-strings --line-regexp --quiet "$latest_sha" "$STATE_FILE"; then
  exit 0
fi

# 뒤로 가는 배포를 막는다. 2026-09-22 에 GitHub 가 「최근 성공한 CI」로 일주일 전
# 커밋을 세 번 돌려주었고, 그때마다 옛 소스가 올라가 alembic 이 지금 DB 판을
# 못 찾고(`Can't locate revision`) 배포가 실패했다. 지금 돌고 있는 것보다 앞선
# 커밋일 때만 간다. 뒤처진 답은 GitHub 가 잠깐 헷갈린 것이라 알림을 울리지 않는다.
deployed_sha="$(head -n 1 "$STATE_FILE" 2>/dev/null || true)"
if [[ "$deployed_sha" =~ ^[0-9a-f]{40}$ ]]; then
  compare_status="$(
    curl --fail --silent --show-error --location       --header 'Accept: application/vnd.github+json'       --header 'X-GitHub-Api-Version: 2022-11-28'       "$COMPARE_URL/$deployed_sha...$latest_sha"       | jq --exit-status --raw-output '.status'
  )" || compare_status=unknown
  if [[ "$compare_status" != "ahead" && "$compare_status" != "unknown" ]]; then
    echo "GitHub says $latest_sha is $compare_status of the deployed $deployed_sha; skipping"
    exit 0
  fi
fi

work_dir="$(mktemp --directory /tmp/daymo-release.XXXXXX)"
trap 'rm -rf "$work_dir"' EXIT

curl --fail --silent --show-error --location \
  "https://github.com/HwangSlater/daymo/archive/$latest_sha.tar.gz" \
  --output "$work_dir/source.tar.gz"
tar --extract --gzip --file "$work_dir/source.tar.gz" --directory "$work_dir"
source_dir="$work_dir/daymo-$latest_sha"
test -d "$source_dir/backend"

# backend/ 가 그대로면 배포하지 않는다. 폴러는 커밋 해시만 보는데, mobile 이나
# 문서만 고친 커밋에도 API 컨테이너를 다시 만들어 몇 초 동안 502 가 났다. 여기서
# 지금 돌고 있는 것과 견줘 같으면 해시만 적어 두고 넘어간다.
if [[ -d "$APP_DIR/backend" ]] &&
  diff --recursive --brief --exclude='__pycache__' --exclude='*.pyc' \
    "$APP_DIR/backend" "$source_dir/backend" >/dev/null 2>&1; then
  echo "backend unchanged; recording $latest_sha without redeploying"
  printf '%s\n' "$latest_sha" >"$STATE_FILE.new"
  mv "$STATE_FILE.new" "$STATE_FILE"
  exit 0
fi

tar --directory "$source_dir" \
  --exclude='._*' --exclude='.DS_Store' \
  --create --gzip --file "$work_dir/release.tar.gz" backend
install -o daymo-deploy -g daymo-deploy -m 0600 \
  "$work_dir/release.tar.gz" "$RELEASE_ARCHIVE"

/usr/local/sbin/daymo-deploy
printf '%s\n' "$latest_sha" >"$STATE_FILE.new"
mv "$STATE_FILE.new" "$STATE_FILE"
