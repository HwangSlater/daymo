# 실제 값은 커밋하지 않는다. 이 파일만 커밋한다.
# 자세한 설명은 docs/development/11-owner-setup-guide.md 6장.

APP_ENV=local

# localhost 로 두지 마라. 윈도우에서 ::1 로 풀려 연결이 멈춘다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=daymo
DB_USERNAME=daymo
# 로컬 compose.yml 의 기본값은 daymo 다. 운영 값을 여기 적지 않는다.
DB_PASSWORD=

# 서로 다른 긴 난수여야 한다. APP_ENV 가 beta/production 이면 비어 있을 때
# 서버가 뜨지 않는다. 아래로 만든다.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=
