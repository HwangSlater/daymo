# 실제 값은 커밋하지 않는다. 이 파일만 커밋한다.
# 자세한 설명은 docs/development/11-owner-setup-guide.md 6장.

APP_ENV=local

# localhost 로 두지 마라. 윈도우에서 ::1 로 풀려 연결이 멈춘다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=daymo
DB_USERNAME=daymo
# 로컬 compose.yml 의 기본값은 daymo 다. 운영 값을 여기 적지 않는다.
DB_PASSWORD=

# 서로 다른 긴 난수여야 한다. APP_ENV 가 beta/production 이면 비어 있을 때
# 서버가 뜨지 않는다. 아래로 만든다.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=

# 소셜 로그인. 제공자마다 값이 다 있어야 그 제공자가 켜지고, 비어 있으면 앱에
# 버튼이 나오지 않는다. 받는 곳과 콘솔에 등록할 주소는
# docs/development/11-owner-setup-guide.md 7장.
# 콘솔에 등록할 redirect URI: {AUTH_LINK_BASE}/v1/auth/oauth/{google|apple|kakao|naver}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 내용을 줄바꿈 대신 \n 으로 적은 한 줄
APPLE_PRIVATE_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 로그인 뒤 돌아갈 수 있는 앱 주소. 쉼표로 여럿. Expo Go 로 시험하면 exp://<PC IP>:8081/--/oauth 를 더한다.
OAUTH_APP_REDIRECT_URIS=daymo://oauth,https://www.daymo.xyz/oauth,https://daymo.xyz/oauth
