digraph daymo_erd {
  graph [rankdir=LR, bgcolor="#FCFBF8", pad="0.35", nodesep="0.35", ranksep="1.05",
         splines=polyline, overlap=false, newrank=true, fontname="Arial",
         label="Daymo ERD · 비용 · 정산", labelloc=t, fontsize=22, fontcolor="#292929"];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8, arrowsize=0.7, penwidth=1.2];
  subgraph cluster_expense {
    label="비용 · 정산"; color="#DDF3F4"; penwidth=2; style="rounded";
    fontname="Arial"; fontsize=15;
    "expenses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#DDF3F4" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>expenses</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_id" ALIGN="LEFT">trip_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK · IDX</B></FONT></TD></TR><TR><TD PORT="p_trip_day_id" ALIGN="LEFT">trip_day_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK · IDX</B></FONT></TD></TR><TR><TD PORT="p_title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">NUMERIC(14, 2)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_category" ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_payer_membership_id" ALIGN="LEFT">payer_membership_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK · IDX</B></FONT></TD></TR><TR><TD PORT="p_split_mode" ALIGN="LEFT">split_mode</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_memo" ALIGN="LEFT">memo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TEXT?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_receipt_photo_id" ALIGN="LEFT">receipt_photo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_excluded" ALIGN="LEFT">excluded</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_transport_id" ALIGN="LEFT">transport_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
    "expense_shares" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#DDF3F4" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>expense_shares</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_expense_id" ALIGN="LEFT">expense_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_membership_id" ALIGN="LEFT">membership_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_weight" ALIGN="LEFT">weight</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">NUMERIC(14, 4)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR></TABLE>>];
    "payments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#DDF3F4" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>payments</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_id" ALIGN="LEFT">trip_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_from_membership_id" ALIGN="LEFT">from_membership_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_to_membership_id" ALIGN="LEFT">to_membership_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">NUMERIC(14, 2)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_paid_at" ALIGN="LEFT">paid_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_deleted_at" ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_deleted_by" ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
  }
  "memberships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>memberships</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 10개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "photos" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>photos</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 22개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "trip_days" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>trip_days</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 5개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "trips" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>trips</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 25개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>users</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 14개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "expense_shares":p_expense_id:w -> "expenses":p_id:e [label="expense_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expense_shares_expense_id_expenses"];
  "expense_shares":p_membership_id:w -> "memberships":p_id:e [label="membership_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expense_shares_membership_id_memberships"];
  "expenses":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expenses_created_by_users"];
  "expenses":p_payer_membership_id:w -> "memberships":p_id:e [label="payer_membership_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expenses_payer_membership_id_memberships"];
  "expenses":p_receipt_photo_id:w -> "photos":p_id:e [label="receipt_photo_id · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expenses_receipt_photo_id_photos"];
  "expenses":p_trip_day_id:w -> "trip_days":p_id:e [label="trip_day_id · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expenses_trip_day_id_trip_days"];
  "expenses":p_trip_id:w -> "trips":p_id:e [label="trip_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_expenses_trip_id_trips"];
  "payments":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_payments_created_by_users"];
  "payments":p_deleted_by:w -> "users":p_id:e [label="deleted_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_payments_deleted_by_users"];
  "payments":p_from_membership_id:w -> "memberships":p_id:e [label="from_membership_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_payments_from_membership_id_memberships"];
  "payments":p_to_membership_id:w -> "memberships":p_id:e [label="to_membership_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_payments_to_membership_id_memberships"];
  "payments":p_trip_id:w -> "trips":p_id:e [label="trip_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_payments_trip_id_trips"];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BBBBBB">
    <TR><TD BGCOLOR="#EEEEEE"><B>범례</B></TD></TR>
    <TR><TD ALIGN="LEFT">PK 기본키 · FK 외래키 · UK 고유키 · IDX 단일 컬럼 인덱스 · ? NULL 허용</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#C65D3B">CASCADE</FONT> · <FONT COLOR="#5575A5">SET NULL</FONT> · <FONT COLOR="#9A6A21">RESTRICT</FONT> · 회색 NO ACTION</TD></TR>
    <TR><TD ALIGN="LEFT">target_type + target_id 같은 다형 참조는 DB FK가 아니므로 관계선에서 제외</TD></TR>
  </TABLE>>];
}
