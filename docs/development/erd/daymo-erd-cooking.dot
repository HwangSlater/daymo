digraph daymo_erd {
  graph [rankdir=LR, bgcolor="#FCFBF8", pad="0.35", nodesep="0.35", ranksep="1.05",
         splines=polyline, overlap=false, newrank=true, fontname="Arial",
         label="Daymo ERD · 준비물 · 요리", labelloc=t, fontsize=22, fontcolor="#292929"];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8, arrowsize=0.7, penwidth=1.2];
  subgraph cluster_cooking {
    label="준비물 · 요리"; color="#FCE3EC"; penwidth=2; style="rounded";
    fontname="Arial"; fontsize=15;
    "checklists" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#FCE3EC" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>checklists</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_id" ALIGN="LEFT">trip_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(40)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
    "checklist_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#FCE3EC" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>checklist_items</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_checklist_id" ALIGN="LEFT">checklist_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_owner_membership_id" ALIGN="LEFT">owner_membership_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_is_shared" ALIGN="LEFT">is_shared</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_completed_at" ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_completed_by" ALIGN="LEFT">completed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_source_ingredient_id" ALIGN="LEFT">source_ingredient_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK · IDX</B></FONT></TD></TR><TR><TD PORT="p_sort_order" ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
    "recipes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#FCE3EC" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>recipes</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_id" ALIGN="LEFT">trip_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_memo" ALIGN="LEFT">memo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TEXT?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_source_url" ALIGN="LEFT">source_url</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(2048)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_servings" ALIGN="LEFT">servings</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_sort_order" ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
    "ingredients" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#FCE3EC" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>ingredients</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_recipe_id" ALIGN="LEFT">recipe_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_category" ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(30)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_procurement" ALIGN="LEFT">procurement</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_owner_membership_id" ALIGN="LEFT">owner_membership_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_completed_at" ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_sort_order" ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
  }
  "memberships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>memberships</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 10개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "trips" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>trips</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 25개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>users</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 14개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "checklist_items":p_checklist_id:w -> "checklists":p_id:e [label="checklist_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklist_items_checklist_id_checklists"];
  "checklist_items":p_completed_by:w -> "memberships":p_id:e [label="completed_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklist_items_completed_by_memberships"];
  "checklist_items":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklist_items_created_by_users"];
  "checklist_items":p_owner_membership_id:w -> "memberships":p_id:e [label="owner_membership_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklist_items_owner_membership_id_memberships"];
  "checklist_items":p_source_ingredient_id:w -> "ingredients":p_id:e [label="source_ingredient_id · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklist_items_source_ingredient_id_ingredients"];
  "checklists":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklists_created_by_users"];
  "checklists":p_trip_id:w -> "trips":p_id:e [label="trip_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_checklists_trip_id_trips"];
  "ingredients":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_ingredients_created_by_users"];
  "ingredients":p_owner_membership_id:w -> "memberships":p_id:e [label="owner_membership_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_ingredients_owner_membership_id_memberships"];
  "ingredients":p_recipe_id:w -> "recipes":p_id:e [label="recipe_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_ingredients_recipe_id_recipes"];
  "recipes":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_recipes_created_by_users"];
  "recipes":p_trip_id:w -> "trips":p_id:e [label="trip_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_recipes_trip_id_trips"];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BBBBBB">
    <TR><TD BGCOLOR="#EEEEEE"><B>범례</B></TD></TR>
    <TR><TD ALIGN="LEFT">PK 기본키 · FK 외래키 · UK 고유키 · IDX 단일 컬럼 인덱스 · ? NULL 허용</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#C65D3B">CASCADE</FONT> · <FONT COLOR="#5575A5">SET NULL</FONT> · <FONT COLOR="#9A6A21">RESTRICT</FONT> · 회색 NO ACTION</TD></TR>
    <TR><TD ALIGN="LEFT">target_type + target_id 같은 다형 참조는 DB FK가 아니므로 관계선에서 제외</TD></TR>
  </TABLE>>];
}
