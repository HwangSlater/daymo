digraph daymo_erd {
  graph [rankdir=LR, bgcolor="#FCFBF8", pad="0.35", nodesep="0.35", ranksep="1.05",
         splines=polyline, overlap=false, newrank=true, fontname="Arial",
         label="Daymo 운영 DB 전체 ERD · 개요", labelloc=t, fontsize=22, fontcolor="#292929"];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8, arrowsize=0.7, penwidth=1.2];
  subgraph cluster_account {
    label="계정 · 인증"; color="#DCEBFF"; penwidth=2; style="rounded";
    fontname="Arial"; fontsize=15;
    "users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#DCEBFF" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>users</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_email" ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(320)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>UK</B></FONT></TD></TR><TR><TD PORT="p_status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 11개 컬럼</FONT></TD></TR></TABLE>>];
