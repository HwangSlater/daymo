digraph daymo_erd {
  graph [rankdir=LR, bgcolor="#FCFBF8", pad="0.35", nodesep="0.35", ranksep="1.05",
         splines=polyline, overlap=false, newrank=true, fontname="Arial",
         label="Daymo ERD · 장소 · 태그", labelloc=t, fontsize=22, fontcolor="#292929"];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8, arrowsize=0.7, penwidth=1.2];
  subgraph cluster_place {
    label="장소 · 태그"; color="#E9E2FA"; penwidth=2; style="rounded";
    fontname="Arial"; fontsize=15;
    "places" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#E9E2FA" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>places</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_address" ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(300)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_latitude" ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">NUMERIC(8, 6)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_longitude" ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">NUMERIC(9, 6)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_provider" ALIGN="LEFT">provider</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_provider_place_id" ALIGN="LEFT">provider_place_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR></TABLE>>];
    "trip_places" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#E9E2FA" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>trip_places</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_id" ALIGN="LEFT">trip_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_place_id" ALIGN="LEFT">place_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK · IDX</B></FONT></TD></TR><TR><TD PORT="p_category" ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(30)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_area" ALIGN="LEFT">area</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(30)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_memo" ALIGN="LEFT">memo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TEXT?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INTEGER</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
    "tags" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#E9E2FA" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>tags</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_space_id" ALIGN="LEFT">space_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_scope" ALIGN="LEFT">scope</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_color" ALIGN="LEFT">color</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
    "taggings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#E9E2FA" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>taggings</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_tag_id" ALIGN="LEFT">tag_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD PORT="p_target_type" ALIGN="LEFT">target_type</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_target_id" ALIGN="LEFT">target_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR></TABLE>>];
    "external_links" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#E9E2FA" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>external_links</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_target_type" ALIGN="LEFT">target_type</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_target_id" ALIGN="LEFT">target_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_provider" ALIGN="LEFT">provider</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_url" ALIGN="LEFT">url</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(2048)</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_label" ALIGN="LEFT">label</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(40)?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR></TABLE>>];
  }
  "schedule_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>schedule_items</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_place_id" ALIGN="LEFT">trip_place_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 12개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "spaces" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>spaces</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 10개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "stays" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>stays</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD PORT="p_trip_place_id" ALIGN="LEFT">trip_place_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>FK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 11개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "trips" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>trips</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 25개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#B8B8B8"><TR><TD BGCOLOR="#F2F2F2" COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="13"><B>users</B></FONT></TD></TR><TR><TD PORT="p_id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">UUID</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>PK</B></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#888888">… 14개 컬럼</FONT></TD></TR></TABLE>>, opacity=0.72];
  "external_links":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_external_links_created_by_users"];
  "schedule_items":p_trip_place_id:w -> "trip_places":p_id:e [label="trip_place_id · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_schedule_items_trip_place_id_trip_places"];
  "stays":p_trip_place_id:w -> "trip_places":p_id:e [label="trip_place_id · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_stays_trip_place_id_trip_places"];
  "taggings":p_tag_id:w -> "tags":p_id:e [label="tag_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_taggings_tag_id_tags"];
  "tags":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_tags_created_by_users"];
  "tags":p_space_id:w -> "spaces":p_id:e [label="space_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_tags_space_id_spaces"];
  "trip_places":p_created_by:w -> "users":p_id:e [label="created_by · SET NULL", color="#5575A5", fontcolor="#5575A5", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_trip_places_created_by_users"];
  "trip_places":p_place_id:w -> "places":p_id:e [label="place_id · RESTRICT", color="#9A6A21", fontcolor="#9A6A21", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_trip_places_place_id_places"];
  "trip_places":p_trip_id:w -> "trips":p_id:e [label="trip_id · CASCADE", color="#C65D3B", fontcolor="#C65D3B", arrowhead=teetee, arrowtail=crow, dir=both, tooltip="fk_trip_places_trip_id_trips"];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#BBBBBB">
    <TR><TD BGCOLOR="#EEEEEE"><B>범례</B></TD></TR>
    <TR><TD ALIGN="LEFT">PK 기본키 · FK 외래키 · UK 고유키 · IDX 단일 컬럼 인덱스 · ? NULL 허용</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#C65D3B">CASCADE</FONT> · <FONT COLOR="#5575A5">SET NULL</FONT> · <FONT COLOR="#9A6A21">RESTRICT</FONT> · 회색 NO ACTION</TD></TR>
    <TR><TD ALIGN="LEFT">target_type + target_id 같은 다형 참조는 DB FK가 아니므로 관계선에서 제외</TD></TR>
  </TABLE>>];
