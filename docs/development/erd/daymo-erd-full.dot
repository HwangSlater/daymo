;</FONT></TD></TR><TR><TD PORT="p_deletion_requested_at" ALIGN="LEFT">deletion_requested_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_deletion_scheduled_at" ALIGN="LEFT">deletion_scheduled_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31"><B>IDX</B></FONT></TD></TR><TR><TD PORT="p_deleted_at" ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME?</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR><TR><TD PORT="p_updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#8A4F31">&#160;</FONT></TD></TR></TABLE>>];
